# Supabase Configuration
# Get these from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your_anon_key

# Google AdSense
# Keep disabled during approval/review unless you have reviewed every ad route.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-6644397387275334
# NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
# NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
# NEXT_PUBLIC_ADSENSE_SLOT_VERTICAL=
# NEXT_PUBLIC_ADSENSE_SLOT_RAIL=

# Sentry Error Monitoring (optional)
# Get DSN from sentry.io > Project > Settings > Client Keys
VITE_SENTRY_DSN=

# Google Analytics 4 (optional)
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
